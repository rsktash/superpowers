#!/usr/bin/env node
import crypto from "node:crypto";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { execFileSync } from "node:child_process";
import { createRequire } from "node:module";
import { performance } from "node:perf_hooks";

const SCHEMA = 1;
const VALID_QUERIES = new Set(["symbol", "callers", "tests", "languages"]);
const LANGUAGE_ORDER = ["typescript", "go", "kotlin", "swift", "python", "other"];
const LANGUAGE_NAMES = {
  typescript: "TypeScript",
  go: "Go",
  kotlin: "Kotlin",
  swift: "Swift",
  python: "Python",
  other: "Other",
};
const EXTENSION_LANGUAGES = new Map([
  [".ts", "typescript"],
  [".tsx", "typescript"],
  [".go", "go"],
  [".kt", "kotlin"],
  [".kts", "kotlin"],
  [".swift", "swift"],
  [".py", "python"],
]);

function fail(message, status = 2) {
  process.stderr.write(`${message}\n`);
  process.exit(status);
}

function parseArguments(argv) {
  const [query, ...operands] = argv;
  if (!VALID_QUERIES.has(query)) {
    fail("usage: structural-index (<symbol|callers|tests> <name>|languages) --repo <root> [--regen]");
  }

  let symbol;
  let flags;
  if (query === "languages") {
    flags = operands;
  } else {
    [symbol, ...flags] = operands;
    if (!symbol) {
      fail("usage: structural-index (<symbol|callers|tests> <name>|languages) --repo <root> [--regen]");
    }
  }

  let repo;
  let regen = false;
  for (let index = 0; index < flags.length; index += 1) {
    if (flags[index] === "--repo" && flags[index + 1]) {
      repo = flags[index + 1];
      index += 1;
    } else if (flags[index] === "--regen") {
      regen = true;
    } else {
      fail(`unknown argument: ${flags[index]}`);
    }
  }
  if (!repo) fail("missing required --repo <root>");
  return { query, symbol, repo: fs.realpathSync(repo), regen };
}

function gitLines(repo, patterns) {
  const output = execFileSync("git", ["-C", repo, "ls-files", "-z", "--", ...patterns]);
  return output.toString("utf8").split("\0").filter(Boolean);
}

function trackedFilesByLanguage(repo) {
  const files = Object.fromEntries(LANGUAGE_ORDER.map((id) => [id, []]));
  for (const file of gitLines(repo, [])) {
    const id = EXTENSION_LANGUAGES.get(path.extname(file)) ?? "other";
    files[id].push(file);
  }
  return files;
}

function targetHead(repo) {
  return execFileSync("git", ["-C", repo, "rev-parse", "HEAD"], { encoding: "utf8" }).trim();
}

function loadTypeScript(repo) {
  const packageDirectories = new Set([repo]);
  for (const packageFile of gitLines(repo, ["package.json", "**/package.json"])) {
    packageDirectories.add(path.join(repo, path.dirname(packageFile)));
  }

  for (const directory of packageDirectories) {
    const implementation = path.join(directory, "node_modules", "typescript", "lib", "typescript.js");
    if (fs.existsSync(implementation)) {
      return createRequire(import.meta.url)(implementation);
    }
  }

  const fallbackDirectory = process.env.STRUCTURAL_INDEX_TYPESCRIPT_PACKAGE;
  if (fallbackDirectory) {
    const implementation = path.resolve(fallbackDirectory, "lib", "typescript.js");
    if (fs.existsSync(implementation)) {
      return createRequire(import.meta.url)(implementation);
    }
    throw new Error(`TypeScript package not found via STRUCTURAL_INDEX_TYPESCRIPT_PACKAGE: ${implementation}`);
  }
  throw new Error(
    `TypeScript package not found under target repository: ${repo}; `
    + "set STRUCTURAL_INDEX_TYPESCRIPT_PACKAGE to a directory holding lib/typescript.js",
  );
}

function definitionCandidates(ts, sourceFile) {
  const definitions = [];

  function add(name, node, nameNode, callable) {
    const startOffset = node.getStart(sourceFile);
    const endOffset = node.getEnd();
    const start = sourceFile.getLineAndCharacterOfPosition(startOffset).line + 1;
    const end = sourceFile.getLineAndCharacterOfPosition(endOffset - 1).line + 1;
    definitions.push({ name, node, nameNode, callable, startOffset, endOffset, start, end });
  }

  function visit(node) {
    if (ts.isFunctionDeclaration(node) && node.name) {
      add(node.name.text, node, node.name, true);
    } else if (ts.isMethodDeclaration(node) && node.name && ts.isIdentifier(node.name)) {
      const owner = node.parent;
      if (ts.isClassDeclaration(owner) && owner.name) {
        add(`${owner.name.text}.${node.name.text}`, node, node.name, true);
      }
    } else if (ts.isVariableStatement(node)) {
      for (const declaration of node.declarationList.declarations) {
        if (!ts.isIdentifier(declaration.name)) continue;
        const callable = Boolean(
          declaration.initializer
          && (ts.isArrowFunction(declaration.initializer) || ts.isFunctionExpression(declaration.initializer)),
        );
        add(declaration.name.text, node, declaration.name, callable);
      }
    } else if (
      (ts.isClassDeclaration(node)
        || ts.isInterfaceDeclaration(node)
        || ts.isTypeAliasDeclaration(node)
        || ts.isEnumDeclaration(node))
      && node.name
    ) {
      add(node.name.text, node, node.name, false);
    }
    ts.forEachChild(node, visit);
  }

  visit(sourceFile);
  return definitions;
}

function resolvedSymbol(ts, checker, symbol) {
  if (!symbol) return undefined;
  if (symbol.flags & ts.SymbolFlags.Alias) {
    const target = checker.getAliasedSymbol(symbol);
    return target.flags & ts.SymbolFlags.Unknown ? symbol : target;
  }
  return symbol;
}

function dynamicImportAliases(ts, checker, sourceFiles) {
  const aliases = new Map();

  function visit(node) {
    if (ts.isBindingElement(node) && ts.isIdentifier(node.name) && ts.isObjectBindingPattern(node.parent)) {
      const declaration = node.parent.parent;
      const initializer = ts.isVariableDeclaration(declaration) ? declaration.initializer : undefined;
      const importCall = initializer && ts.isAwaitExpression(initializer) ? initializer.expression : initializer;
      if (initializer && importCall && ts.isCallExpression(importCall) && importCall.expression.kind === ts.SyntaxKind.ImportKeyword) {
        const local = checker.getSymbolAtLocation(node.name);
        const importedType = checker.getTypeAtLocation(initializer);
        const importedName = node.propertyName && ts.isIdentifier(node.propertyName)
          ? node.propertyName.text
          : node.name.text;
        const imported = checker.getPropertyOfType(importedType, importedName);
        const target = resolvedSymbol(ts, checker, imported);
        if (local && target) aliases.set(local, target);
      }
    }
    ts.forEachChild(node, visit);
  }

  for (const sourceFile of sourceFiles) visit(sourceFile);
  return aliases;
}

function isInvocation(ts, node) {
  const parent = node.parent;
  if (ts.isCallExpression(parent) && parent.expression === node) return true;
  if (
    ts.isPropertyAccessExpression(parent)
    && parent.name === node
    && ts.isCallExpression(parent.parent)
    && parent.parent.expression === parent
  ) return true;
  return Boolean(
    (ts.isJsxOpeningElement(parent) || ts.isJsxSelfClosingElement(parent))
    && parent.tagName === node,
  );
}

function isTestFile(fileName) {
  return /(^|\/)__tests__(\/|$)/.test(fileName) || /\.(test|spec)\.[^/]+$/.test(fileName);
}

function isGoTestFile(fileName) {
  return fileName.endsWith("_test.go");
}

function isTextTestFile(language, fileName) {
  if (language === "kotlin") {
    return fileName.endsWith("Test.kt") || /(^|\/)src\/[^/]*Test\//.test(fileName);
  }
  if (language === "swift") {
    return fileName.endsWith("Tests.swift") || /(^|\/)Tests\//.test(fileName);
  }
  if (language === "python") {
    const baseName = path.posix.basename(fileName);
    return (baseName.startsWith("test_") || baseName.endsWith("_test.py"))
      && baseName.endsWith(".py")
      || /(^|\/)tests\//.test(fileName);
  }
  return false;
}

function textAnswer(repo, files, roster, query, symbol) {
  const uncovered = roster.filter((entry) => entry.backend === "none");
  const candidates = [];
  for (const entry of uncovered) {
    for (const file of files[entry.id]) {
      if (query === "tests" && !isTextTestFile(entry.id, file)) continue;
      candidates.push(file);
    }
  }

  const escaped = symbol.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const word = new RegExp(`(?<![A-Za-z0-9_])${escaped}(?![A-Za-z0-9_])`, "u");
  const sites = [];
  for (const file of candidates) {
    const lines = fs.readFileSync(path.join(repo, file), "utf8").split("\n");
    for (let index = 0; index < lines.length; index += 1) {
      if (word.test(lines[index])) sites.push(`${file}:${index + 1}`);
    }
  }
  return {
    count: candidates.length,
    ids: uncovered.map((entry) => entry.id),
    sites: sites.sort(sortSites),
  };
}

function indexProgram(ts, repo, program, tracked, rows) {
  const checker = program.getTypeChecker();
  const sourceFiles = program.getSourceFiles().filter((sourceFile) => tracked.has(path.resolve(sourceFile.fileName)));
  const definitionsBySymbol = new Map();
  const definitionLocations = new Set();

  for (const sourceFile of sourceFiles) {
    const relativeFile = path.relative(repo, sourceFile.fileName).split(path.sep).join("/");
    const source = sourceFile.text;
    for (const definition of definitionCandidates(ts, sourceFile)) {
      const symbol = resolvedSymbol(ts, checker, checker.getSymbolAtLocation(definition.nameNode));
      if (!symbol) continue;
      const key = `${relativeFile}\0${definition.startOffset}\0${definition.endOffset}\0${definition.name}`;
      if (!rows.has(key)) {
        rows.set(key, {
          name: definition.name,
          file: relativeFile,
          start: definition.start,
          end: definition.end,
          hash: crypto.createHash("sha256")
            .update(source.slice(definition.startOffset, definition.endOffset))
            .digest("hex")
            .slice(0, 12),
          callers: new Set(),
          tests: new Set(),
        });
      }
      const entries = definitionsBySymbol.get(symbol) ?? [];
      entries.push({ key, callable: definition.callable });
      definitionsBySymbol.set(symbol, entries);
      definitionLocations.add(`${path.resolve(sourceFile.fileName)}\0${definition.nameNode.getStart(sourceFile)}`);
    }
  }

  const aliases = dynamicImportAliases(ts, checker, sourceFiles);

  function visitReference(sourceFile, node) {
    if (ts.isIdentifier(node)) {
      const location = `${path.resolve(sourceFile.fileName)}\0${node.getStart(sourceFile)}`;
      if (!definitionLocations.has(location)) {
        const local = checker.getSymbolAtLocation(node);
        const symbol = aliases.get(local) ?? resolvedSymbol(ts, checker, local);
        const definitions = definitionsBySymbol.get(symbol) ?? [];
        if (definitions.length > 0) {
          const relativeFile = path.relative(repo, sourceFile.fileName).split(path.sep).join("/");
          const line = sourceFile.getLineAndCharacterOfPosition(node.getStart(sourceFile)).line + 1;
          const site = `${relativeFile}:${line}`;
          for (const definition of definitions) {
            if (definition.callable && !isInvocation(ts, node)) continue;
            rows.get(definition.key).callers.add(site);
            if (isTestFile(relativeFile)) rows.get(definition.key).tests.add(site);
          }
        }
      }
    }
    ts.forEachChild(node, (child) => visitReference(sourceFile, child));
  }

  for (const sourceFile of sourceFiles) visitReference(sourceFile, sourceFile);
}

function compilerPrograms(ts, repo, files, tracked) {
  const programs = [];
  for (const configFile of gitLines(repo, ["*tsconfig*.json"])) {
    const absoluteConfig = path.join(repo, configFile);
    const read = ts.readConfigFile(absoluteConfig, ts.sys.readFile);
    if (read.error) continue;
    const parsed = ts.parseJsonConfigFileContent(read.config, ts.sys, path.dirname(absoluteConfig), {
      noEmit: true,
      skipLibCheck: true,
    }, absoluteConfig);
    const configFiles = parsed.fileNames.filter((fileName) => tracked.has(path.resolve(fileName)));
    if (configFiles.length > 0) programs.push(ts.createProgram(configFiles, parsed.options));
  }

  programs.push(ts.createProgram(files, {
    allowImportingTsExtensions: true,
    jsx: ts.JsxEmit.ReactJSX,
    module: ts.ModuleKind.ESNext,
    moduleResolution: ts.ModuleResolutionKind.Bundler,
    noEmit: true,
    skipLibCheck: true,
    target: ts.ScriptTarget.ES2022,
  }));
  return programs;
}

function sortSites(left, right) {
  const leftSplit = left.lastIndexOf(":");
  const rightSplit = right.lastIndexOf(":");
  const byFile = left.slice(0, leftSplit).localeCompare(right.slice(0, rightSplit));
  return byFile || Number(left.slice(leftSplit + 1)) - Number(right.slice(rightSplit + 1));
}

function normalizeDefinitions(rows) {
  return rows
    .map((row) => ({
      ...row,
      callers: [...new Set(row.callers)].sort(sortSites),
      tests: [...new Set(row.tests)].sort(sortSites),
    }))
    .sort((left, right) => left.name.localeCompare(right.name)
      || left.file.localeCompare(right.file)
      || left.start - right.start);
}

function generateTypeScript(repo) {
  const started = performance.now();
  const ts = loadTypeScript(repo);
  const relativeFiles = gitLines(repo, ["*.ts", "*.tsx"]);
  const files = relativeFiles.map((fileName) => path.resolve(repo, fileName));
  const tracked = new Set(files);
  const rows = new Map();

  for (const program of compilerPrograms(ts, repo, files, tracked)) {
    indexProgram(ts, repo, program, tracked, rows);
  }

  return {
    data: { schema: SCHEMA, language: "typescript", definitions: normalizeDefinitions([...rows.values()]) },
    seconds: (performance.now() - started) / 1000,
  };
}

const GO_GENERATOR_SOURCE = String.raw`package main

import (
	"bufio"
	"crypto/sha256"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"go/ast"
	"go/parser"
	"go/token"
	"go/types"
	"os"
	"path"
	"path/filepath"
	"sort"
	"strconv"
	"strings"
)

type parsedFile struct {
	rel     string
	src     string
	file    *ast.File
	isTest  bool
	pkgName string
}

type unit struct {
	importPath string
	pkgName    string
	files      []*parsedFile
	importable bool
}

type rowKey struct {
	rel        string
	start, end token.Pos
	name       string
}

type siteKey struct {
	rel string
	pos token.Pos
}

type row struct {
	name     string
	file     string
	start    int
	end      int
	hash     string
	callable bool
	callers  map[string]bool
}

type moduleInfo struct {
	dir  string
	path string
}

type unitInfo struct {
	unit *unit
	info *types.Info
}

type generator struct {
	repo       string
	fset       *token.FileSet
	modules    []moduleInfo
	units      []*unit
	importable map[string]*unit
	checked    map[string]bool
	memo       map[string]*types.Package
	loading    map[string]bool
	rows       map[rowKey]*row
	order      []*row
	byObject   map[types.Object][]*row
	defSites   map[siteKey]bool
	infos      []*unitInfo
}

type parentWalker struct {
	parent  ast.Node
	parents map[ast.Node]ast.Node
	g       *generator
	pf      *parsedFile
	info    *types.Info
}

func (w *parentWalker) Visit(n ast.Node) ast.Visitor {
	if n == nil {
		return nil
	}
	w.parents[n] = w.parent
	if id, ok := n.(*ast.Ident); ok {
		w.g.recordReference(w.pf, w.info, id, w.parent, w.parents)
	}
	return &parentWalker{parent: n, parents: w.parents, g: w.g, pf: w.pf, info: w.info}
}

func (g *generator) recordReference(pf *parsedFile, info *types.Info, id *ast.Ident, parent ast.Node, parents map[ast.Node]ast.Node) {
	if g.defSites[siteKey{pf.rel, id.Pos()}] {
		return
	}
	obj := info.Uses[id]
	if obj == nil {
		return
	}
	rows := g.byObject[obj]
	if len(rows) == 0 {
		return
	}
	callee := false
	switch p := parent.(type) {
	case *ast.CallExpr:
		callee = p.Fun == id
	case *ast.SelectorExpr:
		if p.Sel == id {
			if call, ok := parents[p].(*ast.CallExpr); ok {
				callee = call.Fun == p
			}
		}
	}
	line := g.fset.Position(id.Pos()).Line
	site := pf.rel + ":" + strconv.Itoa(line)
	for _, r := range rows {
		if r.callable && !callee {
			continue
		}
		r.callers[site] = true
	}
}

func receiverBase(expr ast.Expr) string {
	switch t := expr.(type) {
	case *ast.StarExpr:
		return receiverBase(t.X)
	case *ast.Ident:
		return t.Name
	case *ast.IndexExpr:
		return receiverBase(t.X)
	case *ast.IndexListExpr:
		return receiverBase(t.X)
	}
	return ""
}

func (g *generator) addRow(pf *parsedFile, info *types.Info, name string, node ast.Node, nameNode *ast.Ident, callable bool) {
	key := rowKey{pf.rel, node.Pos(), node.End(), name}
	r, ok := g.rows[key]
	if !ok {
		start := g.fset.Position(node.Pos())
		end := g.fset.Position(node.End() - 1)
		endOffset := g.fset.Position(node.End()).Offset
		sum := sha256.Sum256([]byte(pf.src[start.Offset:endOffset]))
		r = &row{
			name:     name,
			file:     pf.rel,
			start:    start.Line,
			end:      end.Line,
			hash:     hex.EncodeToString(sum[:])[:12],
			callable: callable,
			callers:  map[string]bool{},
		}
		g.rows[key] = r
		g.order = append(g.order, r)
	}
	g.defSites[siteKey{pf.rel, nameNode.Pos()}] = true
	if obj := info.Defs[nameNode]; obj != nil {
		g.byObject[obj] = append(g.byObject[obj], r)
	}
}

func (g *generator) collectDefinitions(u *unit, info *types.Info) {
	for _, pf := range u.files {
		ast.Inspect(pf.file, func(n ast.Node) bool {
			switch d := n.(type) {
			case *ast.FuncDecl:
				name := d.Name.Name
				if d.Recv != nil && len(d.Recv.List) > 0 {
					base := receiverBase(d.Recv.List[0].Type)
					if base == "" {
						return true
					}
					name = base + "." + name
				}
				g.addRow(pf, info, name, d, d.Name, true)
			case *ast.GenDecl:
				switch d.Tok {
				case token.TYPE:
					for _, s := range d.Specs {
						if ts, ok := s.(*ast.TypeSpec); ok {
							node := ast.Node(d)
							if d.Lparen.IsValid() {
								node = ts
							}
							g.addRow(pf, info, ts.Name.Name, node, ts.Name, false)
						}
					}
				case token.VAR, token.CONST:
					for _, s := range d.Specs {
						if vs, ok := s.(*ast.ValueSpec); ok {
							node := ast.Node(d)
							if d.Lparen.IsValid() {
								node = vs
							}
							for i, id := range vs.Names {
								callable := false
								if i < len(vs.Values) {
									_, callable = vs.Values[i].(*ast.FuncLit)
								}
								g.addRow(pf, info, id.Name, node, id, callable)
							}
						}
					}
				}
			}
			return true
		})
	}
}

func (g *generator) checkUnit(u *unit) *types.Package {
	if g.checked[u.importPath] {
		return g.memo[u.importPath]
	}
	g.checked[u.importPath] = true
	info := &types.Info{
		Defs: map[*ast.Ident]types.Object{},
		Uses: map[*ast.Ident]types.Object{},
	}
	conf := types.Config{
		Importer:    g,
		Error:       func(error) {},
		FakeImportC: true,
	}
	files := make([]*ast.File, 0, len(u.files))
	for _, pf := range u.files {
		files = append(files, pf.file)
	}
	pkg, _ := conf.Check(u.importPath, g.fset, files, info)
	if u.importable && pkg != nil {
		g.memo[u.importPath] = pkg
	}
	g.collectDefinitions(u, info)
	g.infos = append(g.infos, &unitInfo{unit: u, info: info})
	return pkg
}

func (g *generator) Import(importPath string) (*types.Package, error) {
	if pkg, ok := g.memo[importPath]; ok {
		return pkg, nil
	}
	if g.loading[importPath] {
		return nil, fmt.Errorf("import cycle through %s", importPath)
	}
	u, ok := g.importable[importPath]
	if !ok {
		return nil, fmt.Errorf("import not resolved from source (tolerated): %s", importPath)
	}
	g.loading[importPath] = true
	pkg := g.checkUnit(u)
	delete(g.loading, importPath)
	if pkg == nil {
		return nil, fmt.Errorf("source check produced no package: %s", importPath)
	}
	g.memo[importPath] = pkg
	return pkg, nil
}

func (g *generator) importPathFor(dir string) string {
	for _, m := range g.modules {
		if m.dir == dir {
			return m.path
		}
		if m.dir == "." {
			return m.path + "/" + dir
		}
		if strings.HasPrefix(dir, m.dir+"/") {
			return m.path + dir[len(m.dir):]
		}
	}
	return "~unresolved/" + dir
}

func parseModule(repo string, rel string) (moduleInfo, bool) {
	content, err := os.ReadFile(filepath.Join(repo, filepath.FromSlash(rel)))
	if err != nil {
		return moduleInfo{}, false
	}
	for _, line := range strings.Split(string(content), "\n") {
		fields := strings.Fields(strings.TrimSpace(line))
		if len(fields) >= 2 && fields[0] == "module" {
			return moduleInfo{dir: path.Dir(rel), path: fields[1]}, true
		}
	}
	return moduleInfo{}, false
}

func (g *generator) buildUnits(files []*parsedFile) {
	filesByDir := map[string][]*parsedFile{}
	var dirs []string
	for _, pf := range files {
		dir := path.Dir(pf.rel)
		if _, ok := filesByDir[dir]; !ok {
			dirs = append(dirs, dir)
		}
		filesByDir[dir] = append(filesByDir[dir], pf)
	}
	sort.Strings(dirs)
	for _, dir := range dirs {
		pfs := filesByDir[dir]
		dirPath := g.importPathFor(dir)
		byPkg := map[string][]*parsedFile{}
		var pkgNames []string
		basePkg := ""
		for _, pf := range pfs {
			if _, ok := byPkg[pf.pkgName]; !ok {
				pkgNames = append(pkgNames, pf.pkgName)
			}
			byPkg[pf.pkgName] = append(byPkg[pf.pkgName], pf)
			if !pf.isTest && basePkg == "" {
				basePkg = pf.pkgName
			}
		}
		sort.Strings(pkgNames)
		for _, pkgName := range pkgNames {
			group := byPkg[pkgName]
			if pkgName == basePkg {
				var nonTest []*parsedFile
				hasTests := false
				for _, pf := range group {
					if pf.isTest {
						hasTests = true
					} else {
						nonTest = append(nonTest, pf)
					}
				}
				if len(nonTest) > 0 {
					u := &unit{importPath: dirPath, pkgName: pkgName, files: nonTest, importable: true}
					g.units = append(g.units, u)
					g.importable[dirPath] = u
				}
				if hasTests {
					u := &unit{importPath: dirPath + " [test]", pkgName: pkgName, files: group}
					g.units = append(g.units, u)
				}
			} else {
				nonTest := false
				for _, pf := range group {
					if !pf.isTest {
						nonTest = true
					}
				}
				suffix := pkgName
				if !nonTest {
					suffix = pkgName + " test"
				}
				u := &unit{importPath: dirPath + " [" + suffix + "]", pkgName: pkgName, files: group}
				g.units = append(g.units, u)
			}
		}
	}
}

func (g *generator) walkReferences() {
	for _, ui := range g.infos {
		for _, pf := range ui.unit.files {
			parents := map[ast.Node]ast.Node{}
			ast.Walk(&parentWalker{parents: parents, g: g, pf: pf, info: ui.info}, pf.file)
		}
	}
}

func (g *generator) emit() {
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	for i, r := range g.order {
		callable := 0
		if r.callable {
			callable = 1
		}
		fmt.Fprintf(out, "D\t%d\t%s\t%s\t%d\t%d\t%s\t%d\n", i, r.name, r.file, r.start, r.end, r.hash, callable)
		sites := make([]string, 0, len(r.callers))
		for site := range r.callers {
			sites = append(sites, site)
		}
		sort.Strings(sites)
		for _, site := range sites {
			fmt.Fprintf(out, "C\t%d\t%s\n", i, site)
		}
	}
}

func run() error {
	var input struct {
		Repo    string
		Files   []string
		Modules []string
	}
	if err := json.NewDecoder(os.Stdin).Decode(&input); err != nil {
		return err
	}
	g := &generator{
		repo:       input.Repo,
		fset:       token.NewFileSet(),
		importable: map[string]*unit{},
		checked:    map[string]bool{},
		memo:       map[string]*types.Package{},
		loading:    map[string]bool{},
		rows:       map[rowKey]*row{},
		byObject:   map[types.Object][]*row{},
		defSites:   map[siteKey]bool{},
	}
	var files []*parsedFile
	for _, rel := range input.Files {
		content, err := os.ReadFile(filepath.Join(input.Repo, filepath.FromSlash(rel)))
		if err != nil {
			continue
		}
		f, _ := parser.ParseFile(g.fset, filepath.Join(input.Repo, filepath.FromSlash(rel)), content, parser.SkipObjectResolution)
		if f == nil || f.Name == nil {
			continue
		}
		files = append(files, &parsedFile{
			rel:     rel,
			src:     string(content),
			file:    f,
			isTest:  strings.HasSuffix(rel, "_test.go"),
			pkgName: f.Name.Name,
		})
	}
	for _, rel := range input.Modules {
		if m, ok := parseModule(input.Repo, rel); ok {
			g.modules = append(g.modules, m)
		}
	}
	sort.Slice(g.modules, func(i, j int) bool {
		return len(g.modules[i].dir) > len(g.modules[j].dir)
	})
	g.buildUnits(files)
	for _, u := range g.units {
		g.checkUnit(u)
	}
	g.walkReferences()
	g.emit()
	return nil
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "structural-index-go: "+err.Error())
		os.Exit(1)
	}
}
`;

function generateGo(repo, goFiles) {
  const started = performance.now();
  const modules = gitLines(repo, ["go.mod", "**/go.mod"]);
  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "structural-index-go-"));
  let stdout;
  try {
    const sourcePath = path.join(directory, "main.go");
    fs.writeFileSync(sourcePath, GO_GENERATOR_SOURCE);
    stdout = execFileSync("go", ["run", sourcePath], {
      input: JSON.stringify({ repo, files: goFiles, modules }),
      maxBuffer: 256 * 1024 * 1024,
    }).toString("utf8");
  } catch (error) {
    const detail = error.stderr ? `: ${error.stderr.toString("utf8").trim()}` : "";
    throw new Error(`Go backend failed${detail || `: ${error.message}`}`);
  } finally {
    fs.rmSync(directory, { recursive: true, force: true });
  }
  const rows = [];
  for (const line of stdout.split("\n")) {
    if (!line) continue;
    const fields = line.split("\t");
    if (fields[0] === "D" && fields.length === 8) {
      rows.push({
        name: fields[2],
        file: fields[3],
        start: Number(fields[4]),
        end: Number(fields[5]),
        hash: fields[6],
        callable: fields[7] === "1",
        callers: new Set(),
        tests: new Set(),
      });
    } else if (fields[0] === "C" && fields.length === 3) {
      const row = rows[Number(fields[1])];
      if (!row) throw new Error(`Go backend referenced unknown row: ${line}`);
      row.callers.add(fields[2]);
      const splitAt = fields[2].lastIndexOf(":");
      if (isGoTestFile(fields[2].slice(0, splitAt))) row.tests.add(fields[2]);
    } else {
      throw new Error(`Go backend emitted an unexpected line: ${line}`);
    }
  }
  return {
    data: { schema: SCHEMA, language: "go", definitions: normalizeDefinitions(rows) },
    seconds: (performance.now() - started) / 1000,
  };
}

const LANGUAGE_GENERATORS = {
  typescript: (repo) => generateTypeScript(repo),
  go: (repo, files) => generateGo(repo, files),
  kotlin: (repo, files) => generateKotlin(repo, files),
  swift: (repo, files) => generateSwift(repo, files),
  python: (repo, files) => generatePython(repo, files),
};

// The tree-sitter Node binding ships a 32 KiB input buffer; the largest
// tracked Kotlin sources exceed it, so every parse passes a 1 MiB buffer
// (measured in the superpowers-5f7.6 trial).
const KOTLIN_PARSE_OPTIONS = { bufferSize: 1024 * 1024 };

function loadKotlinToolchain(repo) {
  const modulePaths = (directory) => [
    path.join(directory, "node_modules", "tree-sitter"),
    path.join(directory, "node_modules", "tree-sitter-kotlin"),
  ];
  const holds = (entries) => entries.every((entry) => fs.existsSync(entry));

  const packageDirectories = new Set([repo]);
  for (const packageFile of gitLines(repo, ["package.json", "**/package.json"])) {
    packageDirectories.add(path.join(repo, path.dirname(packageFile)));
  }
  const require = createRequire(import.meta.url);
  for (const directory of packageDirectories) {
    const entries = modulePaths(directory);
    if (holds(entries)) return entries.map((entry) => require(entry));
  }

  const fallbackDirectory = process.env.STRUCTURAL_INDEX_KOTLIN_TOOLCHAIN;
  if (fallbackDirectory) {
    const entries = modulePaths(path.resolve(fallbackDirectory));
    if (!holds(entries)) {
      throw new Error(
        `Kotlin toolchain not found via STRUCTURAL_INDEX_KOTLIN_TOOLCHAIN: ${fallbackDirectory} `
        + "(expected node_modules/tree-sitter and node_modules/tree-sitter-kotlin inside it)",
      );
    }
    return entries.map((entry) => require(entry));
  }
  throw new Error(
    `Kotlin toolchain not found under target repository: ${repo}; `
    + "set STRUCTURAL_INDEX_KOTLIN_TOOLCHAIN to a directory holding "
    + "node_modules/tree-sitter and node_modules/tree-sitter-kotlin",
  );
}

function kotlinNearest(node, types) {
  for (let current = node; current; current = current.parent) {
    if (types.has(current.type)) return current;
  }
  return null;
}

function kotlinDirectChild(node, type) {
  return node.namedChildren.find((child) => child.type === type) ?? null;
}

function kotlinDeclaration(node) {
  if (node.type === "function_declaration") {
    const nameNode = kotlinDirectChild(node, "simple_identifier");
    if (!nameNode) return null;
    const container = kotlinNearest(node.parent, new Set(["class_declaration", "object_declaration"]));
    if (!container) return { name: nameNode.text, nameNode, callable: true };
    const containerName = kotlinDirectChild(container, "type_identifier");
    // A function inside an anonymous object declares no nameable scope: its
    // site is still a definition site, but it earns no row.
    if (!containerName) return { name: null, nameNode, callable: true };
    return { name: `${containerName.text}.${nameNode.text}`, nameNode, callable: true };
  }
  if (node.type === "class_declaration" || node.type === "object_declaration") {
    const nameNode = kotlinDirectChild(node, "type_identifier");
    return nameNode ? { name: nameNode.text, nameNode, callable: false } : null;
  }
  if (node.type === "property_declaration" && /\bconst\s+val\b/.test(node.text.slice(0, 120))) {
    const nameNode = node.descendantsOfType("simple_identifier")[0] ?? null;
    return nameNode ? { name: nameNode.text, nameNode, callable: false } : null;
  }
  return null;
}

function kotlinIsCallee(node) {
  const call = kotlinNearest(node.parent, new Set(["call_expression"]));
  if (!call) return false;
  const suffix = call.namedChildren.find((child) => child.type === "call_suffix");
  return suffix ? node.endIndex <= suffix.startIndex : node.startIndex === call.startIndex;
}

function generateKotlin(repo, kotlinFiles) {
  const started = performance.now();
  const [Parser, Kotlin] = loadKotlinToolchain(repo);
  const parser = new Parser();
  parser.setLanguage(Kotlin);

  const rows = [];
  const rowsByBareName = new Map();
  const parsedFiles = [];
  for (const file of kotlinFiles) {
    const source = fs.readFileSync(path.join(repo, file), "utf8");
    const tree = parser.parse(source, null, KOTLIN_PARSE_OPTIONS);
    const nameOffsets = new Set();

    for (const node of tree.rootNode.descendantsOfType([
      "function_declaration",
      "class_declaration",
      "object_declaration",
      "property_declaration",
    ])) {
      const declaration = kotlinDeclaration(node);
      if (!declaration) continue;
      nameOffsets.add(declaration.nameNode.startIndex);
      if (!declaration.name) continue;
      const end = node.endPosition.column === 0 && node.endIndex > node.startIndex
        ? node.endPosition.row
        : node.endPosition.row + 1;
      const row = {
        name: declaration.name,
        file,
        start: node.startPosition.row + 1,
        end,
        hash: crypto.createHash("sha256")
          .update(source.slice(node.startIndex, node.endIndex))
          .digest("hex")
          .slice(0, 12),
        callable: declaration.callable,
        callers: new Set(),
        tests: new Set(),
      };
      rows.push(row);
      const bareName = declaration.name.split(".").pop();
      const list = rowsByBareName.get(bareName) ?? [];
      list.push(row);
      rowsByBareName.set(bareName, list);
    }

    parsedFiles.push({ file, tree, nameOffsets });
  }

  // References resolve against every definition, so the walk runs only
  // after all files contributed their rows.
  for (const { file, tree, nameOffsets } of parsedFiles) {
    for (const node of tree.rootNode.descendantsOfType(["simple_identifier", "type_identifier"])) {
      const candidates = rowsByBareName.get(node.text);
      if (!candidates || nameOffsets.has(node.startIndex)) continue;
      if (kotlinNearest(node.parent, new Set(["import_header", "package_header"]))) continue;
      const site = `${file}:${node.startPosition.row + 1}`;
      for (const row of candidates) {
        if (row.callable && !kotlinIsCallee(node)) continue;
        row.callers.add(site);
        if (isTextTestFile("kotlin", file)) row.tests.add(site);
      }
    }
  }

  return {
    data: { schema: SCHEMA, language: "kotlin", definitions: normalizeDefinitions(rows) },
    seconds: (performance.now() - started) / 1000,
  };
}

// The tree-sitter Node binding ships a 32 KiB input buffer; every parse
// passes a 1 MiB buffer (measured in the superpowers-5f7.7 trial).
const SWIFT_PARSE_OPTIONS = { bufferSize: 1024 * 1024 };

function loadSwiftToolchain(repo) {
  const modulePaths = (directory) => [
    path.join(directory, "node_modules", "tree-sitter"),
    path.join(directory, "node_modules", "tree-sitter-swift"),
  ];
  const holds = (entries) => entries.every((entry) => fs.existsSync(entry));

  const packageDirectories = new Set([repo]);
  for (const packageFile of gitLines(repo, ["package.json", "**/package.json"])) {
    packageDirectories.add(path.join(repo, path.dirname(packageFile)));
  }
  const require = createRequire(import.meta.url);
  for (const directory of packageDirectories) {
    const entries = modulePaths(directory);
    if (holds(entries)) return entries.map((entry) => require(entry));
  }

  const fallbackDirectory = process.env.STRUCTURAL_INDEX_SWIFT_TOOLCHAIN;
  if (fallbackDirectory) {
    const entries = modulePaths(path.resolve(fallbackDirectory));
    if (!holds(entries)) {
      throw new Error(
        `Swift toolchain not found via STRUCTURAL_INDEX_SWIFT_TOOLCHAIN: ${fallbackDirectory} `
        + "(expected node_modules/tree-sitter and node_modules/tree-sitter-swift inside it)",
      );
    }
    return entries.map((entry) => require(entry));
  }
  throw new Error(
    `Swift toolchain not found under target repository: ${repo}; `
    + "set STRUCTURAL_INDEX_SWIFT_TOOLCHAIN to a directory holding "
    + "node_modules/tree-sitter and node_modules/tree-sitter-swift",
  );
}

function swiftNearest(node, types) {
  for (let current = node; current; current = current.parent) {
    if (types.has(current.type)) return current;
  }
  return null;
}

function swiftDirectChild(node, type) {
  return node.namedChildren.find((child) => child.type === type) ?? null;
}

function swiftHeadKeyword(node) {
  const firstLine = node.text.split("\n", 1)[0];
  const match = firstLine.match(/\b(struct|class|enum|protocol|actor|extension)\b/);
  return match ? match[1] : null;
}

function swiftContainerName(node) {
  const nameNode = swiftDirectChild(node, "type_identifier")
    ?? swiftDirectChild(node, "user_type")?.namedChildren.find((child) => child.type === "type_identifier")
    ?? null;
  return nameNode?.text ?? null;
}

function swiftDeclaration(node) {
  if (node.type === "function_declaration") {
    const nameNode = swiftDirectChild(node, "simple_identifier");
    if (!nameNode) return null;
    const container = swiftNearest(node.parent, new Set(["class_declaration"]));
    if (!container) return { name: nameNode.text, nameNode, callable: true };
    const containerName = swiftContainerName(container);
    // A function inside a container that declares no nameable scope (an
    // extension of a non-identifier type, for example) earns no row.
    if (!containerName) return { name: null, nameNode, callable: true };
    return { name: `${containerName}.${nameNode.text}`, nameNode, callable: true };
  }
  if (node.type === "class_declaration") {
    const nameNode = swiftDirectChild(node, "type_identifier");
    if (!nameNode) return null;
    // struct and class carry type rows; enum, protocol, actor, and extension
    // names resolve only as references (measured in the superpowers-5f7.7
    // trial).
    const keyword = swiftHeadKeyword(node);
    if (keyword !== "struct" && keyword !== "class") return null;
    return { name: nameNode.text, nameNode, callable: false };
  }
  if (node.type === "property_declaration") {
    // A property inside a function or closure body is local: it earns no
    // row (the trial measured only file- and type-scope properties).
    if (swiftNearest(node.parent, new Set(["function_declaration", "closure_expression"]))) return null;
    const pattern = swiftDirectChild(node, "pattern");
    const nameNode = pattern?.namedChildren.find((child) => child.type === "simple_identifier") ?? null;
    return nameNode ? { name: nameNode.text, nameNode, callable: false } : null;
  }
  return null;
}

function swiftIsCallee(node) {
  const parent = node.parent;
  if (!parent) return false;
  if (parent.type === "call_expression" && parent.namedChildren[0] === node) return true;
  // A prefix operator between the callee and its call (`!done(...)`) wraps
  // the callee; the trial looked through that wrapper.
  if (parent.type === "prefix_expression" && parent.namedChildren[parent.namedChildren.length - 1] === node) {
    const grandparent = parent.parent;
    if (grandparent?.type === "call_expression" && grandparent.namedChildren[0] === parent) return true;
  }
  if (parent.type === "navigation_suffix" && parent.namedChildren[parent.namedChildren.length - 1] === node) {
    const navigation = parent.parent;
    if (navigation?.type === "navigation_expression") {
      const grandparent = navigation.parent;
      if (grandparent?.type === "call_expression" && grandparent.namedChildren[0] === navigation) return true;
    }
  }
  return false;
}

function generateSwift(repo, swiftFiles) {
  const started = performance.now();
  const [Parser, Swift] = loadSwiftToolchain(repo);
  const parser = new Parser();
  parser.setLanguage(Swift);

  const rows = [];
  const rowsByBareName = new Map();
  const parsedFiles = [];
  for (const file of swiftFiles) {
    const source = fs.readFileSync(path.join(repo, file), "utf8");
    const tree = parser.parse(source, null, SWIFT_PARSE_OPTIONS);
    const nameOffsets = new Set();

    for (const node of tree.rootNode.descendantsOfType([
      "function_declaration",
      "class_declaration",
      "property_declaration",
    ])) {
      const declaration = swiftDeclaration(node);
      if (!declaration) continue;
      nameOffsets.add(declaration.nameNode.startIndex);
      if (!declaration.name) continue;
      const end = node.endPosition.column === 0 && node.endIndex > node.startIndex
        ? node.endPosition.row
        : node.endPosition.row + 1;
      const row = {
        name: declaration.name,
        file,
        start: node.startPosition.row + 1,
        end,
        hash: crypto.createHash("sha256")
          .update(source.slice(node.startIndex, node.endIndex))
          .digest("hex")
          .slice(0, 12),
        callable: declaration.callable,
        callers: new Set(),
        tests: new Set(),
      };
      rows.push(row);
      const bareName = declaration.name.split(".").pop();
      const list = rowsByBareName.get(bareName) ?? [];
      list.push(row);
      rowsByBareName.set(bareName, list);
    }

    parsedFiles.push({ file, tree, nameOffsets });
  }

  // References resolve against every definition, so the walk runs only
  // after all files contributed their rows.
  for (const { file, tree, nameOffsets } of parsedFiles) {
    for (const node of tree.rootNode.descendantsOfType(["simple_identifier", "type_identifier"])) {
      const candidates = rowsByBareName.get(node.text);
      if (!candidates || nameOffsets.has(node.startIndex)) continue;
      if (swiftNearest(node.parent, new Set(["import_declaration"]))) continue;
      const site = `${file}:${node.startPosition.row + 1}`;
      for (const row of candidates) {
        if (row.callable && !swiftIsCallee(node)) continue;
        row.callers.add(site);
        if (isTextTestFile("swift", file)) row.tests.add(site);
      }
    }
  }

  return {
    data: { schema: SCHEMA, language: "swift", definitions: normalizeDefinitions(rows) },
    seconds: (performance.now() - started) / 1000,
  };
}

// The Python backend runs the standard-library ast + symtable parser
// through the resolved interpreter (approved in R-35 and measured in the
// superpowers-5f7.8 trial: 13/13 exact spans, 93.22%/100% callers); no
// grammar or binding is vendored.
const PYTHON_GENERATOR_SOURCE = String.raw`import ast
import hashlib
import json
import symtable
import sys


def locals_of(table):
    # Imported names (symtable marks them local) alias the imported symbol,
    # so they do not shadow module-level symbols of the same name.
    names = set()
    for symbol in table.get_symbols():
        if symbol.is_local() and not symbol.is_imported():
            names.add(symbol.get_name())
    return names


def child_table(table, name):
    symbol = table.lookup(name)
    if symbol is not None and symbol.is_local() and symbol.get_namespace() is not None:
        namespaces = symbol.get_namespaces()
        return namespaces[0] if namespaces else None
    return None


class DefinitionCollector(ast.NodeVisitor):
    def __init__(self, file, line_starts, source_bytes, rows):
        self.file = file
        self.line_starts = line_starts
        self.source_bytes = source_bytes
        self.rows = rows
        self.class_stack = []
        self.scope_stack = ["module"]

    def _add(self, name, node, callable_):
        start = self.line_starts[node.lineno - 1] + node.col_offset
        end = self.line_starts[node.end_lineno - 1] + node.end_col_offset
        self.rows.append({
            "name": name,
            "file": self.file,
            "start": node.lineno,
            "end": node.end_lineno,
            "hash": hashlib.sha256(self.source_bytes[start:end]).hexdigest()[:12],
            "callable": callable_,
        })

    def visit_ClassDef(self, node):
        # A class nested in a class declares no nameable module scope: no row.
        if not self.class_stack:
            self._add(node.name, node, False)
        self.class_stack.append(node.name)
        self.scope_stack.append("class")
        self.generic_visit(node)
        self.scope_stack.pop()
        self.class_stack.pop()

    def _visit_func(self, node):
        if self.scope_stack[-1] == "class":
            self._add(self.class_stack[-1] + "." + node.name, node, True)
        elif self.scope_stack[-1] == "module":
            self._add(node.name, node, True)
        # A function nested in a function is local: it earns no row.
        self.scope_stack.append("function")
        self.generic_visit(node)
        self.scope_stack.pop()

    visit_FunctionDef = _visit_func
    visit_AsyncFunctionDef = _visit_func

    def _visit_assign(self, node):
        # Only module-level assignments name constants; class attributes and
        # function locals earn no rows.
        if not self.class_stack and self.scope_stack[-1] == "module":
            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
            for target in targets:
                if isinstance(target, ast.Name):
                    self._add(target.id, node, False)
        self.generic_visit(node)

    visit_Assign = _visit_assign
    visit_AnnAssign = _visit_assign


class ReferenceCollector(ast.NodeVisitor):
    def __init__(self, file, module_functions, methods, values, callers):
        self.file = file
        self.module_functions = module_functions
        self.methods = methods
        self.values = values
        self.callers = callers
        self.scope_stack = []
        self.scope_kinds = []

    def _shadowed(self, name):
        # Function scopes shadow their nested references (the closure
        # chain), and a class scope shadows only code written directly in
        # its body: method bodies never see the class namespace as an
        # enclosing scope. The module scope is scope_stack[0]; module-level
        # locals are the module globals, so it never shadows.
        last = len(self.scope_stack) - 1
        for index in range(1, len(self.scope_stack)):
            if self.scope_kinds[index] == "class" and index != last:
                continue
            if name in self.scope_stack[index][1]:
                return True
        return False

    def _push_scope(self, name, kind):
        if not self.scope_stack:
            return False
        table = child_table(self.scope_stack[-1][0], name)
        if table is None:
            return False
        self.scope_stack.append((table, locals_of(table)))
        self.scope_kinds.append(kind)
        return True

    def visit_ClassDef(self, node):
        pushed = self._push_scope(node.name, "class")
        self.generic_visit(node)
        if pushed:
            self.scope_stack.pop()
            self.scope_kinds.pop()

    def _visit_func(self, node):
        pushed = self._push_scope(node.name, "function")
        self.generic_visit(node)
        if pushed:
            self.scope_stack.pop()
            self.scope_kinds.pop()

    visit_FunctionDef = _visit_func
    visit_AsyncFunctionDef = _visit_func

    def visit_Call(self, node):
        func = node.func
        if isinstance(func, ast.Name):
            if not self._shadowed(func.id):
                for index in self.module_functions.get(func.id, ()):
                    self.callers[index].add(f"{self.file}:{func.lineno}")
        elif isinstance(func, ast.Attribute):
            # Receiver types are invisible without a type checker: method
            # matching stays lexical (accepted in the measured trial).
            for index in self.methods.get(func.attr, ()):
                self.callers[index].add(f"{self.file}:{func.lineno}")
        self.generic_visit(node)

    def visit_Name(self, node):
        # Classes and module-level constants answer any semantic load:
        # instantiation, decorator application, annotation, base class, use.
        if isinstance(node.ctx, ast.Load) and not self._shadowed(node.id):
            for index in self.values.get(node.id, ()):
                self.callers[index].add(f"{self.file}:{node.lineno}")


def run():
    request = json.loads(sys.stdin.read())
    rows = []
    parsed = []
    for rel in request["files"]:
        try:
            with open(request["repo"] + "/" + rel, "rb") as handle:
                source_bytes = handle.read()
            source = source_bytes.decode("utf-8")
            tree = ast.parse(source, filename=rel)
            table = symtable.symtable(source, rel, "exec")
        except (OSError, UnicodeDecodeError, SyntaxError, ValueError):
            continue
        line_starts = [0]
        for line in source.split("\n"):
            line_starts.append(line_starts[-1] + len(line.encode("utf-8")) + 1)
        collector = DefinitionCollector(rel, line_starts, source_bytes, rows)
        collector.visit(tree)
        parsed.append((rel, tree, table))

    module_functions = {}
    methods = {}
    values = {}
    for index, row in enumerate(rows):
        if row["callable"]:
            if "." in row["name"]:
                methods.setdefault(row["name"].split(".")[-1], []).append(index)
            else:
                module_functions.setdefault(row["name"], []).append(index)
        else:
            values.setdefault(row["name"], []).append(index)

    callers = [set() for _ in rows]
    # References resolve against every definition, so the walk runs only
    # after all files contributed their rows.
    for rel, tree, table in parsed:
        walker = ReferenceCollector(rel, module_functions, methods, values, callers)
        walker.scope_stack.append((table, locals_of(table)))
        walker.scope_kinds.append("module")
        walker.visit(tree)

    lines = []
    for index, row in enumerate(rows):
        lines.append(
            "D\t%d\t%s\t%s\t%d\t%d\t%s\t%d"
            % (index, row["name"], row["file"], row["start"], row["end"], row["hash"], 1 if row["callable"] else 0)
        )
    for index, sites in enumerate(callers):
        for site in sorted(sites):
            lines.append("C\t%d\t%s" % (index, site))
    if lines:
        sys.stdout.write("\n".join(lines) + "\n")


def main():
    try:
        run()
    except Exception as error:
        sys.stderr.write(f"structural-index-python: {error}\n")
        sys.exit(1)


if __name__ == "__main__":
    main()
`;

function loadPythonToolchain(repo) {
  const projectDirectories = new Set();
  for (const projectFile of gitLines(repo, [
    "pyproject.toml",
    "**/pyproject.toml",
    "requirements*.txt",
    "**/requirements*.txt",
  ])) {
    projectDirectories.add(path.join(repo, path.dirname(projectFile)));
  }
  for (const directory of projectDirectories) {
    for (const venvName of [".venv", "venv"]) {
      const interpreter = path.join(directory, venvName, "bin", "python3");
      if (fs.existsSync(interpreter)) return interpreter;
    }
  }

  const fallbackDirectory = process.env.STRUCTURAL_INDEX_PYTHON_TOOLCHAIN;
  if (fallbackDirectory) {
    const interpreter = path.join(path.resolve(fallbackDirectory), "bin", "python3");
    if (fs.existsSync(interpreter)) return interpreter;
    throw new Error(
      `Python toolchain not found via STRUCTURAL_INDEX_PYTHON_TOOLCHAIN: ${fallbackDirectory} `
      + "(expected bin/python3 inside it)",
    );
  }
  throw new Error(
    `Python toolchain not found under target repository: ${repo}; `
    + "set STRUCTURAL_INDEX_PYTHON_TOOLCHAIN to a directory holding bin/python3",
  );
}

function generatePython(repo, pythonFiles) {
  const started = performance.now();
  const interpreter = loadPythonToolchain(repo);
  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "structural-index-python-"));
  let stdout;
  try {
    const sourcePath = path.join(directory, "generate.py");
    fs.writeFileSync(sourcePath, PYTHON_GENERATOR_SOURCE);
    stdout = execFileSync(interpreter, [sourcePath], {
      input: JSON.stringify({ repo, files: pythonFiles }),
      maxBuffer: 256 * 1024 * 1024,
    }).toString("utf8");
  } catch (error) {
    const detail = error.stderr ? `: ${error.stderr.toString("utf8").trim()}` : "";
    throw new Error(`Python backend failed${detail || `: ${error.message}`}`);
  } finally {
    fs.rmSync(directory, { recursive: true, force: true });
  }
  const rows = [];
  for (const line of stdout.split("\n")) {
    if (!line) continue;
    const fields = line.split("\t");
    if (fields[0] === "D" && fields.length === 8) {
      rows.push({
        name: fields[2],
        file: fields[3],
        start: Number(fields[4]),
        end: Number(fields[5]),
        hash: fields[6],
        callable: fields[7] === "1",
        callers: new Set(),
        tests: new Set(),
      });
    } else if (fields[0] === "C" && fields.length === 3) {
      const row = rows[Number(fields[1])];
      if (!row) throw new Error(`Python backend referenced unknown row: ${line}`);
      row.callers.add(fields[2]);
      if (isTextTestFile("python", fields[2].slice(0, fields[2].lastIndexOf(":")))) row.tests.add(fields[2]);
    } else {
      throw new Error(`Python backend emitted an unexpected line: ${line}`);
    }
  }
  return {
    data: { schema: SCHEMA, language: "python", definitions: normalizeDefinitions(rows) },
    seconds: (performance.now() - started) / 1000,
  };
}

function languageRoster(files) {
  return LANGUAGE_ORDER
    .filter((id) => files[id].length > 0)
    .map((id) => ({
      id,
      count: files[id].length,
      backend: LANGUAGE_GENERATORS[id] ? "compiler" : "none",
    }));
}

function writeMetadata(indexDirectory, metadata) {
  fs.mkdirSync(indexDirectory, { recursive: true });
  const metadataPath = path.join(indexDirectory, "metadata.json");
  const suffix = `.tmp-${process.pid}`;
  fs.writeFileSync(metadataPath + suffix, `${JSON.stringify(metadata, null, 2)}\n`);
  fs.renameSync(metadataPath + suffix, metadataPath);
}

function generate(repo, head, indexDirectory, files, roster) {
  const data = {};
  const seconds = {};
  for (const id of LANGUAGE_ORDER) {
    const generator = LANGUAGE_GENERATORS[id];
    if (!generator || files[id].length === 0) continue;
    const generated = generator(repo, files[id]);
    data[id] = generated.data;
    seconds[id] = generated.seconds;
  }
  fs.mkdirSync(indexDirectory, { recursive: true });
  const suffix = `.tmp-${process.pid}`;
  for (const id of Object.keys(data)) {
    const dataPath = path.join(indexDirectory, `${id}.json`);
    fs.writeFileSync(dataPath + suffix, `${JSON.stringify(data[id], null, 2)}\n`);
    fs.renameSync(dataPath + suffix, dataPath);
  }
  writeMetadata(indexDirectory, { schema: SCHEMA, commit: head, languages: Object.keys(data), roster });
  return { data, seconds };
}

function readMetadata(indexDirectory) {
  return JSON.parse(fs.readFileSync(path.join(indexDirectory, "metadata.json"), "utf8"));
}

function cachedRoster(indexDirectory, head, roster) {
  try {
    const metadata = readMetadata(indexDirectory);
    return metadata.schema === SCHEMA
      && metadata.commit === head
      && JSON.stringify(metadata.roster) === JSON.stringify(roster);
  } catch {
    return false;
  }
}

function existingIndexedLanguages(indexDirectory, head) {
  try {
    const metadata = readMetadata(indexDirectory);
    if (metadata.schema !== SCHEMA || metadata.commit !== head || !Array.isArray(metadata.languages)) return [];
    for (const id of metadata.languages) {
      if (!LANGUAGE_GENERATORS[id]) return [];
      const parsed = JSON.parse(fs.readFileSync(path.join(indexDirectory, `${id}.json`), "utf8"));
      if (parsed.schema !== SCHEMA) return [];
    }
    return metadata.languages;
  } catch {
    return [];
  }
}

function regenerateRoster(indexDirectory, head, roster) {
  const languages = existingIndexedLanguages(indexDirectory, head);
  writeMetadata(indexDirectory, { schema: SCHEMA, commit: head, languages, roster });
}

function cachedIndex(indexDirectory, head, roster) {
  try {
    const metadata = readMetadata(indexDirectory);
    const present = roster.filter((entry) => entry.backend === "compiler").map((entry) => entry.id);
    if (metadata.schema !== SCHEMA || metadata.commit !== head) return undefined;
    if (JSON.stringify(metadata.languages) !== JSON.stringify(present)) return undefined;
    if (JSON.stringify(metadata.roster) !== JSON.stringify(roster)) return undefined;
    const data = {};
    for (const id of present) {
      const parsed = JSON.parse(fs.readFileSync(path.join(indexDirectory, `${id}.json`), "utf8"));
      if (parsed.schema !== SCHEMA) return undefined;
      data[id] = parsed;
    }
    return data;
  } catch {
    return undefined;
  }
  return undefined;
}

function main() {
  const args = parseArguments(process.argv.slice(2));
  const head = targetHead(args.repo);
  const indexDirectory = path.join(args.repo, ".bd", "index");
  const files = trackedFilesByLanguage(args.repo);
  const roster = languageRoster(files);

  if (args.query === "languages") {
    if (args.regen || !cachedRoster(indexDirectory, head, roster)) {
      regenerateRoster(indexDirectory, head, roster);
    }
    for (const entry of roster) {
      process.stdout.write(`${entry.id}\t${entry.count}\t${entry.backend}\n`);
    }
    return;
  }

  let data = args.regen ? undefined : cachedIndex(indexDirectory, head, roster);
  let seconds;
  if (!data) {
    const generated = generate(args.repo, head, indexDirectory, files, roster);
    data = generated.data;
    seconds = generated.seconds;
  }

  const definitions = [];
  for (const id of LANGUAGE_ORDER) {
    if (!data[id]) continue;
    for (const definition of data[id].definitions) {
      if (definition.name === args.symbol) definitions.push(definition);
    }
  }
  if (definitions.length === 0) {
    const uncovered = roster.filter((entry) => entry.backend === "none");
    const ids = uncovered.map((entry) => entry.id);
    if (args.query === "symbol") {
      const occurrences = textAnswer(args.repo, files, roster, "callers", args.symbol);
      const detail = occurrences.sites.length > 0
        ? `\nstructural-index: no definition backend for ${ids.join(", ")}; not searched`
        : "";
      fail(`symbol not found: ${args.symbol}${detail}`, 1);
    }

    const answer = textAnswer(args.repo, files, roster, args.query, args.symbol);
    if (answer.sites.length === 0) fail(`symbol not found: ${args.symbol}`, 1);
    for (const site of answer.sites) process.stdout.write(`${site}\n`);
    process.stderr.write(
      `structural-index: ${args.query} ${args.symbol} answered by text search over `
      + `${answer.count} files in ${answer.ids.join(", ")}\n`,
    );
    return;
  }
  for (const id of LANGUAGE_ORDER) {
    if (seconds && seconds[id] !== undefined) {
      process.stderr.write(`structural-index: regenerated ${LANGUAGE_NAMES[id]} index in ${seconds[id].toFixed(3)}s\n`);
    }
  }

  if (args.query === "symbol") {
    for (const definition of definitions) {
      process.stdout.write(`${definition.file}\t${definition.start}-${definition.end}\t${definition.hash}\n`);
    }
    return;
  }

  const sites = new Set();
  for (const definition of definitions) {
    for (const site of definition[args.query]) sites.add(site);
  }
  for (const site of [...sites].sort(sortSites)) process.stdout.write(`${site}\n`);
}

try {
  main();
} catch (error) {
  fail(`structural-index: ${error.message}`);
}
